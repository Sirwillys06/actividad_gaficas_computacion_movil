+        xValueMapper: (item, _) => item.label,
+        lowValueMapper: (item, _) => (item.mean - item.deviation).clamp(0, double.infinity),
+        highValueMapper: (item, _) => item.mean + item.deviation,
+        color: ChartPalette.home,
+        borderWidth: 3,
